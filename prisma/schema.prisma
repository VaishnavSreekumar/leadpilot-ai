generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  leads        Lead[]
  aiExecutionLogs AiExecutionLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Lead {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  location            String
  propertyRequirement String
  budgetInr           Int
  buyingTimeline      String
  customerMessage     String

  // Phase 3: AI Analysis fields (nullable so existing Phase 2 leads remain valid)
  aiSummary               String?
  aiIntent                String?
  aiKeyRequirements       String[]  @default([])
  aiObjections            String[]  @default([])
  aiRecommendedNextAction String?
  aiSuggestedResponse     String?
  aiIntentLevel           String?
  aiEngagementLevel       String?
  aiRequirementClarity    String?
  aiSuggestedQuestions    String[]  @default([])
  aiAnalyzedAt            DateTime?
  aiAnalysisStatus        String?   @default("PENDING")

  // Phase 3: Canonical Lead Scoring fields
  leadScore               Int?
  leadPriority            String?

  // Phase 5: Persistent chat cooldown (serverless-safe, stored in DB)
  lastChatRequestAt       DateTime?

  // Phase 6: Smart Follow-Up recommendation (latest generated, not a log)
  followUpRecommendedAt   DateTime?
  followUpReason          String?
  followUpFocusPoints     String[]  @default([])
  followUpMessage         String?
  followUpGeneratedAt     DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  aiExecutionLogs     AiExecutionLog[]

  @@index([userId])
}

model AiExecutionLog {
  id                      String    @id @default(cuid())
  correlationId           String    @unique
  leadId                  String
  lead                    Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId                  String?
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  model                   String
  promptVersion           String
  status                  String    // "SUCCESS" | "FAILED"
  latencyMs               Int
  attempts                Int       @default(1)
  retryCount              Int       @default(0)
  errorType               String?   // "VALIDATION_ERROR" | "PROVIDER_ERROR" | "TIMEOUT_ERROR" | "INTERNAL_ERROR"
  errorMessage            String?   // Sanitized error message (no secrets, tokens, or PII)

  // Quality metrics
  intentLevel             String?   // Extracted intentLevel: HIGH, MEDIUM, LOW
  engagementLevel         String?   // Extracted engagementLevel: HIGH, MEDIUM, LOW
  requirementClarity      String?   // Extracted requirementClarity: CLEAR, PARTIAL, UNCLEAR
  uncertainFields         String[]  @default([])
  keyRequirementsCount    Int       @default(0)
  objectionsCount         Int       @default(0)
  suggestedQuestionsCount Int       @default(0)

  // Token usage (from provider response usageMetadata if available)
  promptTokens            Int?
  responseTokens          Int?
  totalTokens             Int?

  createdAt               DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([userId])
  @@index([correlationId])
  @@index([status])
  @@index([errorType])
  @@index([createdAt])
}


