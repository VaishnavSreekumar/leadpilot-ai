# PostgreSQL Database Connection URL (Server-side only)
# For serverless platforms (e.g. Neon, Supabase, Vercel Postgres), use the pooled connection URL here.
# For local PostgreSQL, standard connection: postgresql://USER:PASSWORD@localhost:5432/leadpilot
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct unpooled PostgreSQL Connection URL (Used for Prisma migrations with connection poolers)
# If using a direct non-pooled database or local PostgreSQL, this can be identical to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Google Gemini API Key (Reserved for Phase 3 AI Prioritization & Intelligence - Not used in Phase 1)
GEMINI_API_KEY=""
